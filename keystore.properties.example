# Copy this file to keystore.properties and fill it with the private AS Team release credentials.
# Never commit keystore.properties or the .jks file.
RELEASE_STORE_FILE=/absolute/path/to/AS-KharjYar-release.jks
RELEASE_STORE_PASSWORD=CHANGE_ME
RELEASE_KEY_ALIAS=as-kharjyar
RELEASE_KEY_PASSWORD=CHANGE_ME
